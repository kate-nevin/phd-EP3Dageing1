    <Routine name="EHI_task_screen">
      <RoutineSettingsComponent name="EHI_task_screen" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="EHI_task_screen" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="handedness_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="r = 0&amp;#10;l = 0" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="r = 0;&amp;#10;l = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="console.log((&quot;R is &quot; + r.toString()));&amp;#10;console.log((&quot;L is &quot; + l.toString()));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="print(&quot;R is &quot; + str(r))&amp;#10;print(&quot;L is &quot; + str(l))" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((writing_slider.getRating() !== null)) {&amp;#10;    writing = Number.parseInt(writing_slider.getRating());&amp;#10;} else {&amp;#10;    writing = 0;&amp;#10;}&amp;#10;if ((drawing_slider.getRating() !== null)) {&amp;#10;    drawing = Number.parseInt(drawing_slider.getRating());&amp;#10;} else {&amp;#10;    drawing = 0;&amp;#10;}&amp;#10;if ((throwing_slider.getRating() !== null)) {&amp;#10;    throwing = Number.parseInt(throwing_slider.getRating());&amp;#10;} else {&amp;#10;    throwing = 0;&amp;#10;}&amp;#10;if ((scissors_slider.getRating() !== null)) {&amp;#10;    scissors = Number.parseInt(scissors_slider.getRating());&amp;#10;} else {&amp;#10;    scissors = 0;&amp;#10;}&amp;#10;if ((toothbrush_slider.getRating() !== null)) {&amp;#10;    toothbrush = Number.parseInt(toothbrush_slider.getRating());&amp;#10;} else {&amp;#10;    toothbrush = 0;&amp;#10;}&amp;#10;if ((knife_slider.getRating() !== null)) {&amp;#10;    knife = Number.parseInt(knife_slider.getRating());&amp;#10;} else {&amp;#10;    knife = 0;&amp;#10;}&amp;#10;if ((spoon_slider.getRating() !== null)) {&amp;#10;    spoon = Number.parseInt(spoon_slider.getRating());&amp;#10;} else {&amp;#10;    spoon = 0;&amp;#10;}&amp;#10;if ((broom_slider.getRating() !== null)) {&amp;#10;    broom = Number.parseInt(broom_slider.getRating());&amp;#10;} else {&amp;#10;    broom = 0;&amp;#10;}&amp;#10;if ((match_slider.getRating() !== null)) {&amp;#10;    match = Number.parseInt(match_slider.getRating());&amp;#10;} else {&amp;#10;    match = 0;&amp;#10;}&amp;#10;if ((lid_slider.getRating() !== null)) {&amp;#10;    lid = Number.parseInt(lid_slider.getRating());&amp;#10;} else {&amp;#10;    lid = 0;&amp;#10;}&amp;#10;if ((writing &gt; 0)) {&amp;#10;    r = (r + writing);&amp;#10;} else {&amp;#10;    if ((writing &lt; 0)) {&amp;#10;        l = (l + writing);&amp;#10;    }&amp;#10;}&amp;#10;if ((drawing &gt; 0)) {&amp;#10;    r = (r + drawing);&amp;#10;} else {&amp;#10;    if ((drawing &lt; 0)) {&amp;#10;        l = (l + drawing);&amp;#10;    }&amp;#10;}&amp;#10;if ((throwing &gt; 0)) {&amp;#10;    r = (r + throwing);&amp;#10;} else {&amp;#10;    if ((throwing &lt; 0)) {&amp;#10;        l = (l + throwing);&amp;#10;    }&amp;#10;}&amp;#10;if ((scissors &gt; 0)) {&amp;#10;    r = (r + scissors);&amp;#10;} else {&amp;#10;    if ((scissors &lt; 0)) {&amp;#10;        l = (l + scissors);&amp;#10;    }&amp;#10;}&amp;#10;if ((toothbrush &gt; 0)) {&amp;#10;    r = (r + toothbrush);&amp;#10;} else {&amp;#10;    if ((toothbrush &lt; 0)) {&amp;#10;        l = (l + toothbrush);&amp;#10;    }&amp;#10;}&amp;#10;if ((knife &gt; 0)) {&amp;#10;    r = (r + knife);&amp;#10;} else {&amp;#10;    if ((knife &lt; 0)) {&amp;#10;        l = (l + knife);&amp;#10;    }&amp;#10;}&amp;#10;if ((spoon &gt; 0)) {&amp;#10;    r = (r + spoon);&amp;#10;} else {&amp;#10;    if ((spoon &lt; 0)) {&amp;#10;        l = (l + spoon);&amp;#10;    }&amp;#10;}&amp;#10;if ((broom &gt; 0)) {&amp;#10;    r = (r + broom);&amp;#10;} else {&amp;#10;    if ((broom &lt; 0)) {&amp;#10;        l = (l + broom);&amp;#10;    }&amp;#10;}&amp;#10;if ((match &gt; 0)) {&amp;#10;    r = (r + match);&amp;#10;} else {&amp;#10;    if ((match &lt; 0)) {&amp;#10;        l = (l + match);&amp;#10;    }&amp;#10;}&amp;#10;if ((lid &gt; 0)) {&amp;#10;    r = (r + lid);&amp;#10;} else {&amp;#10;    if ((lid &lt; 0)) {&amp;#10;        l = (l + lid);&amp;#10;    }&amp;#10;}&amp;#10;r = Math.abs(r);&amp;#10;l = Math.abs(l);&amp;#10;console.log((&quot;R is now &quot; + r.toString()));&amp;#10;console.log((&quot;L is now &quot; + l.toString()));&amp;#10;LQ = (((r - l) / (r + l)) * 100);&amp;#10;console.log((&quot;LQ is &quot; + LQ.toString()));&amp;#10;psychoJS.experiment.addData(&quot;r&quot;, r);&amp;#10;psychoJS.experiment.addData(&quot;l&quot;, l);&amp;#10;psychoJS.experiment.addData(&quot;LQ&quot;, LQ);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Convert rating scores to integer values&amp;#10;if writing_slider.getRating() is not None:&amp;#10;    writing = int(writing_slider.getRating())&amp;#10;else:&amp;#10;    writing = 0&amp;#10;    &amp;#10;if drawing_slider.getRating() is not None:&amp;#10;    drawing = int(drawing_slider.getRating())&amp;#10;else:&amp;#10;    drawing = 0&amp;#10;&amp;#10;if throwing_slider.getRating() is not None:&amp;#10;    throwing = int(throwing_slider.getRating())&amp;#10;else:&amp;#10;    throwing = 0&amp;#10;&amp;#10;if scissors_slider.getRating() is not None:&amp;#10;    scissors = int(scissors_slider.getRating())&amp;#10;else:&amp;#10;    scissors = 0&amp;#10;&amp;#10;if toothbrush_slider.getRating() is not None:&amp;#10;    toothbrush = int(toothbrush_slider.getRating())&amp;#10;else: &amp;#10;    toothbrush = 0&amp;#10;&amp;#10;if knife_slider.getRating() is not None:&amp;#10;    knife = int(knife_slider.getRating())&amp;#10;else:&amp;#10;    knife = 0&amp;#10;&amp;#10;if spoon_slider.getRating() is not None:&amp;#10;    spoon = int(spoon_slider.getRating())&amp;#10;else:&amp;#10;    spoon = 0&amp;#10;&amp;#10;if broom_slider.getRating() is not None:&amp;#10;    broom = int(broom_slider.getRating())&amp;#10;else:&amp;#10;    broom = 0&amp;#10;&amp;#10;if match_slider.getRating() is not None:&amp;#10;    match = int(match_slider.getRating())&amp;#10;else:&amp;#10;    match = 0&amp;#10;&amp;#10;if lid_slider.getRating() is not None:&amp;#10;    lid = int(lid_slider.getRating())&amp;#10;else:&amp;#10;    lid = 0&amp;#10;&amp;#10;# Add scores to either left or right hand&amp;#10;if writing &gt; 0:&amp;#10;    r = r + writing&amp;#10;elif writing &lt; 0:&amp;#10;    l = l + writing&amp;#10;&amp;#10;if drawing &gt; 0:&amp;#10;    r = r + drawing&amp;#10;elif drawing &lt; 0:&amp;#10;    l = l + drawing&amp;#10;&amp;#10;if throwing &gt; 0:&amp;#10;    r = r + throwing&amp;#10;elif throwing &lt; 0:&amp;#10;    l = l + throwing&amp;#10;&amp;#10;if scissors &gt; 0:&amp;#10;    r = r + scissors&amp;#10;elif scissors &lt; 0:&amp;#10;    l = l + scissors&amp;#10;&amp;#10;if toothbrush &gt; 0:&amp;#10;    r = r + toothbrush&amp;#10;elif toothbrush &lt; 0:&amp;#10;    l = l + toothbrush&amp;#10;&amp;#10;if knife &gt; 0:&amp;#10;    r = r + knife&amp;#10;elif knife &lt; 0:&amp;#10;    l = l + knife&amp;#10;&amp;#10;if spoon &gt; 0:&amp;#10;    r = r + spoon&amp;#10;elif spoon &lt; 0:&amp;#10;    l = l + spoon&amp;#10;&amp;#10;if broom &gt; 0:&amp;#10;    r = r + broom&amp;#10;elif broom &lt; 0:&amp;#10;    l = l + broom&amp;#10;&amp;#10;if match &gt; 0:&amp;#10;    r = r + match&amp;#10;elif match &lt; 0:&amp;#10;    l = l + match&amp;#10;&amp;#10;if lid &gt; 0:&amp;#10;    r = r + lid&amp;#10;elif lid &lt; 0:&amp;#10;    l = l + lid&amp;#10;    &amp;#10;# Get the absolute values of r and l&amp;#10;r = abs(r)&amp;#10;l = abs(l)&amp;#10;&amp;#10;# Check&amp;#10;print(&quot;R is now &quot; + str(r))&amp;#10;print(&quot;L is now &quot; + str(l))&amp;#10;&amp;#10;# Calculate Laterality Quotient&amp;#10;LQ = ((r-l)/(r+l)) * 100&amp;#10;print(&quot;LQ is &quot; + str(LQ))&amp;#10;&amp;#10;# Add to Excel sheet&amp;#10;thisExp.addData(&quot;r&quot;, r)&amp;#10;thisExp.addData(&quot;l&quot;, l)&amp;#10;thisExp.addData(&quot;LQ&quot;, LQ)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
