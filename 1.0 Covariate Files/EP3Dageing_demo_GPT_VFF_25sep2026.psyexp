        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="In this part, the touch detection thresholds of the participant's RIGHT index finger is going to be tested.&amp;#10;&amp;#10;Set up the Von Frey Filaments.&amp;#10;&amp;#10;To log the number of touches that the participant feels each trial, press the corresponding number (0, 1, 2, or 3).&amp;#10;&amp;#10;Press SPACEBAR to continue." valType="str" updates="constant" name="text"/>
