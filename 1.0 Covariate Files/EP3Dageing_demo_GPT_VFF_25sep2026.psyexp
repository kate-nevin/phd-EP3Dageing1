      </RoutineSettingsComponent>
      <CodeComponent name="f_code_desc" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="groove_width_value = groove_width_list[groove_width_counter];&amp;#10;if ((Math.random() &gt; 0.5)) {&amp;#10;    ori = &quot;vertical&quot;;&amp;#10;    corr_resp = &quot;v&quot;;&amp;#10;} else {&amp;#10;    ori = &quot;horizontal&quot;;&amp;#10;    corr_resp = &quot;h&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Specify the filament_value for this trial&amp;#10;f_value = f_list[f_counter]" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="response_list.push(key_resp_desc.corr);&amp;#10;if ((key_resp_desc.corr === 1)) {&amp;#10;    corrSum += 1;&amp;#10;    if ((corrSum === 2)) {&amp;#10;        curr_direction = &quot;down&quot;;&amp;#10;        corrSum = 0;&amp;#10;        if ((groove_width_counter &lt; (groove_width_list.length - 1))) {&amp;#10;            groove_width_counter += 1;&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    corrSum = 0;&amp;#10;    curr_direction = &quot;up&quot;;&amp;#10;    if ((groove_width_counter &gt; 0)) {&amp;#10;        groove_width_counter -= 1;&amp;#10;    }&amp;#10;}&amp;#10;if (((prev_direction !== null) &amp;&amp; (prev_direction !== curr_direction))) {&amp;#10;    num_reversals += 1;&amp;#10;    reversal_widths_list.push(groove_width_value);&amp;#10;    psychoJS.experiment.addData(&quot;reversal_gw&quot;, groove_width_value);&amp;#10;}&amp;#10;prev_direction = curr_direction;&amp;#10;psychoJS.experiment.addData(&quot;groove_width_value&quot;, groove_width_value);&amp;#10;psychoJS.experiment.addData(&quot;corr_resp&quot;, corr_resp);&amp;#10;psychoJS.experiment.addData(&quot;orientation&quot;, ori);&amp;#10;psychoJS.experiment.addData(&quot;key_resp_desc.corr&quot;, key_resp_desc.corr);&amp;#10;psychoJS.experiment.addData(&quot;num_reversals&quot;, num_reversals);&amp;#10;psychoJS.experiment.addData(&quot;trial_num&quot;, trial_num);&amp;#10;psychoJS.experiment.addData(&quot;staircase_type&quot;, staircase_type);&amp;#10;if ((num_reversals === 8)) {&amp;#10;    descending_trials.finished = true;&amp;#10;    console.log(reversal_widths_list);&amp;#10;    if ((reversal_widths_list.length &gt;= 6)) {&amp;#10;        threshold = np.mean(reversal_widths_list.slice((- 6)));&amp;#10;        console.log((&quot;Average threshold is &quot; + threshold.toString()));&amp;#10;        psychoJS.experiment.addData(&quot;threshold&quot;, threshold);&amp;#10;    }&amp;#10;}&amp;#10;trial_num += 1;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="###  Change the value for the next trial based on the response from this trial&amp;#10;&amp;#10;# If 0 or 1 key recorded, log as incorrect trial. If 2 or 3 logged, log as correct trial.&amp;#10;if key_resp_desc.keys[0] == '0':&amp;#10;    key_resp_corr = 0&amp;#10;elif key_resp_desc.keys[0] == '1':&amp;#10;    key_resp_corr = 0&amp;#10;elif key_resp_desc.keys[0] == '2':&amp;#10;    key_resp_corr = 1&amp;#10;elif key_resp_desc.keys[0] == '3':&amp;#10;    key_resp_corr = 1&amp;#10;else:&amp;#10;    print(&quot;Something has gone wrong&quot;)&amp;#10;    &amp;#10;# Add correct or incorrect response to response_list&amp;#10;response_list.append(key_resp_corr)&amp;#10;&amp;#10;# Determine current direction based on correctness&amp;#10;if key_resp_corr == 1:  # Correct response&amp;#10;    corrSum += 1&amp;#10;    if corrSum == 2:  # Move down after 2 correct responses&amp;#10;        curr_direction = 'down'&amp;#10;        corrSum = 0  # Reset correct responses count&amp;#10;        max_counter = 0 # Reset max_counter&amp;#10;        if f_counter &lt; len(f_list) - 1:  # Prevent going below smallest value&amp;#10;            f_counter += 1&amp;#10;        else:&amp;#10;            min_counter += 1&amp;#10;else:  # Incorrect response&amp;#10;    corrSum = 0  # Reset consecutive correct responses count&amp;#10;    curr_direction = 'up'  # Move up on incorrect response&amp;#10;    min_counter = 0 # Reset min_counter&amp;#10;    if f_counter &gt; 0:  # Prevent going below smallest value&amp;#10;        f_counter -= 1&amp;#10;    else:&amp;#10;        max_counter += 1&amp;#10;&amp;#10;# Check if a reversal has occurred&amp;#10;if prev_direction is not None and prev_direction != curr_direction:&amp;#10;    num_reversals += 1&amp;#10;    reversal_widths_list.append(f_value)&amp;#10;    thisExp.addData(&quot;reversal_f&quot;, f_value)&amp;#10;&amp;#10;# Update the previous direction&amp;#10;prev_direction = curr_direction&amp;#10;&amp;#10;# Save trial data to CSV&amp;#10;thisExp.addData('f_value', f_value)&amp;#10;# thisExp.addData('corrAns', corrAns)&amp;#10;thisExp.addData('key_resp_corr', key_resp_corr)&amp;#10;thisExp.addData('num_reversals', num_reversals)&amp;#10;thisExp.addData('trial_num', trial_num)&amp;#10;thisExp.addData('staircase_type', staircase_type)&amp;#10;thisExp.addData('hand_tested', hand_tested)&amp;#10;thisExp.addData('max_counter', max_counter)&amp;#10;thisExp.addData('min_counter', min_counter)&amp;#10;&amp;#10;# End experiment condition&amp;#10;if num_reversals &gt;= 8 or max_counter == 10 or min_counter == 5:&amp;#10;    &amp;#10;    print(reversal_widths_list)&amp;#10;&amp;#10;    # Calculate threshold&amp;#10;    if len(reversal_widths_list) &gt;= 6:&amp;#10;        threshold = np.mean(reversal_widths_list[-6:])&amp;#10;    elif min_counter == 5:&amp;#10;        threshold = 1.65&amp;#10;    elif max_counter == 10:&amp;#10;        threshold = 6.65&amp;#10;&amp;#10;    print(&quot;Average threshold is &quot; + str(threshold))&amp;#10;    thisExp.addData('f_threshold', threshold)&amp;#10;    &amp;#10;    vff_trials.finished = True&amp;#10;&amp;#10;# Increment trial counter&amp;#10;trial_num += 1" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="f_code_desc" valType="code" updates="None" name="name"/>
      </CodeComponent>
